{
  "name": "@gum-jsx/edit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --configLoader runner",
    "build": "tsc --noEmit && bun --bun vite build --configLoader runner",
    "preview": "bun --bun vite preview --configLoader runner",
    "test": "bun test/completions.ts && bun test/emoji.ts && bun test/themes.ts && bun test/sizing.ts && bun test/docs.ts",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/view": "^6.43.11",
    "@fontsource/noto-color-emoji": "^5.3.1",
    "@gum-jsx/core": "workspace:*",
    "@gum-jsx/math": "workspace:*",
    "@uiw/react-codemirror": "^4.25.11",
    "marked": "^18.0.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@gum-jsx/docs": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
